{{ 'purelane.css' | asset_url | stylesheet_tag }}

<aside
  class="purelane-ticker ticker"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t | default: 'Announcements' }}"
  tabindex="0"
>
  <div class="ticker-track track">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="ticker-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</a>
          {%- else -%}
            <span class="ticker-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- comment -%} Duplicate set for continuous looping {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="ticker-item" aria-hidden="true" tabindex="-1">{{ block.settings.text }}</a>
          {%- else -%}
            <span class="ticker-item" aria-hidden="true">{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat ₹499</b></span>
      <span aria-hidden="true">Free shipping <b>on every bundle across India</b></span>
      <span aria-hidden="true">100% plant-based <b>and non-toxic</b></span>
      <span aria-hidden="true">Loved by <b>30,000+ happy homes</b></span>
      <span aria-hidden="true">Buy 3 <b>at flat ₹499</b></span>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Purelane Ticker",
  "class": "section-announcement-bar",
  "max_blocks": 12,
  "settings": [],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Free shipping <b>on every bundle across India</b>",
          "label": "Announcement Text",
          "info": "Use <b> for highlighted green text (e.g. <b>at flat ₹499</b>)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Announcement Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ticker",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free shipping <b>on every bundle across India</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "100% plant-based <b>and non-toxic</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Loved by <b>30,000+ happy homes</b>"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Buy 3 <b>at flat ₹499</b>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
