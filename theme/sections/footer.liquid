{{ 'purelane.css' | asset_url | stylesheet_tag }}

<footer class="purelane-scope purelane-footer" data-scene="4" role="contentinfo" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="fgrid">
      <!-- Brand Column -->
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px" aria-label="{{ shop.name | default: 'Purelane' | escape }} home">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 140 | image_tag: class: 'brand-logo', alt: shop.name }}
          {%- else -%}
            <span class="mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
                <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                <path d="M12 21v-6"/>
              </svg>
            </span>
            <span class="txt">
              <span class="n1">{{ shop.name | default: 'Purelane' | escape }}</span>
              <span class="n2">{{ section.settings.tagline | default: 'Clean, simply' | escape }}</span>
            </span>
          {%- endif -%}
        </a>
        <p style="max-width:30ch">{{ section.settings.brand_description | default: 'Effective cleaning, powered by nature. Made for Indian homes since day one.' | escape }}</p>
      </div>

      <!-- Menu Column 1: Shop -->
      <div class="fcol">
        <h5>{{ section.settings.menu_1_title | default: 'Shop' | escape }}</h5>
        {%- if section.settings.menu_1 != blank and section.settings.menu_1.links.size > 0 -%}
          {%- for link in section.settings.menu_1.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#shop">Bestsellers</a>
          <a href="#shop">Kitchen</a>
          <a href="#shop">Laundry</a>
          <a href="#shop">Home</a>
          <a href="#shop">Skin</a>
          <a href="#bundles">Starter kits</a>
        {%- endif -%}
      </div>

      <!-- Menu Column 2: About -->
      <div class="fcol">
        <h5>{{ section.settings.menu_2_title | default: 'About' | escape }}</h5>
        {%- if section.settings.menu_2 != blank and section.settings.menu_2.links.size > 0 -%}
          {%- for link in section.settings.menu_2.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="#how">How it works</a>
          <a href="#ingredients">Sustainability</a>
          <a href="#proof">FAQs</a>
          <a href="#reviews">Reviews</a>
        {%- endif -%}
      </div>

      <!-- Contact Column -->
      <div class="fcol">
        <h5>{{ section.settings.contact_title | default: 'Get in touch' | escape }}</h5>
        {%- if section.settings.contact_email != blank -%}
          <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>
        {%- else -%}
          <a href="mailto:hello@purelane.com">hello@purelane.com</a>
        {%- endif -%}
        {%- if section.settings.contact_phone != blank -%}
          <a href="tel:{{ section.settings.contact_phone | replace: ' ', '' | escape }}">{{ section.settings.contact_phone | escape }}</a>
        {%- else -%}
          <a href="tel:+919930123234">+91 9930 123 234</a>
        {%- endif -%}
        <p style="font-size:12px;color:rgba(36,26,61,0.56)">{{ section.settings.company_legal | default: 'Purelane Eco Products Pvt Ltd' | escape }}</p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="fbot">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: 'Purelane Eco Products Private Limited' | escape }}</span>
      <span>
        {%- if section.settings.policy_links != blank -%}
          {{ section.settings.policy_links | escape }}
        {%- else -%}
          Privacy &middot; Terms &middot; Refunds &middot; Contact
        {%- endif -%}
      </span>
    </div>
  </div>
</footer>

<!-- Mobile Sticky Bottom CTA Bar (<= 960px) -->
<div class="purelane-scope sticky" role="complementary" aria-label="Quick bundle builder">
  <span class="lbl">
    <b>{{ section.settings.sticky_heading | default: 'Pick any 3, pay ₹499' | escape }}</b>
    <span>{{ section.settings.sticky_subtext | default: 'Free shipping, always' | escape }}</span>
  </span>
  <a class="btn btn-primary btn-sm" href="{{ section.settings.sticky_link | default: '#bundles' }}">
    {{ section.settings.sticky_label | default: 'Build bundle' | escape }}
  </a>
</div>

{% schema %}
{
  "name": "Purelane Footer",
  "tag": "footer",
  "class": "section-purelane-footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Clean, simply"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand Description",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "Menu 1 Title",
      "default": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Menu 1"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Menu 2 Title",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Menu 2"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact Column Title",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Contact Email",
      "default": "hello@purelane.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact Phone",
      "default": "+91 9930 123 234"
    },
    {
      "type": "text",
      "id": "company_legal",
      "label": "Company Legal Name",
      "default": "Purelane Eco Products Pvt Ltd"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Purelane Eco Products Private Limited"
    },
    {
      "type": "text",
      "id": "policy_links",
      "label": "Policy Links Text",
      "default": "Privacy · Terms · Refunds · Contact"
    },
    {
      "type": "header",
      "content": "Mobile Sticky Bar"
    },
    {
      "type": "text",
      "id": "sticky_heading",
      "label": "Sticky Bar Heading",
      "default": "Pick any 3, pay ₹499"
    },
    {
      "type": "text",
      "id": "sticky_subtext",
      "label": "Sticky Bar Subtext",
      "default": "Free shipping, always"
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Sticky Bar CTA Label",
      "default": "Build bundle"
    },
    {
      "type": "url",
      "id": "sticky_link",
      "label": "Sticky Bar CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer"
    }
  ]
}
{% endschema %}
