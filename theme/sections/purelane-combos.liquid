{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section
  class="purelane-scope purelane-combos-section sec"
  id="combos"
  data-scene="3"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.title | escape }}"
>
  <div class="wrap">
    <!-- Header -->
    <div class="panel-head rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      <div class="rule" aria-hidden="true">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>
        <i></i>
      </div>

      {%- if section.settings.lede != blank -%}
        <p class="lede" style="margin:14px auto 0">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Combo Horizontal Scroll Rail -->
    <div
      class="comborail rv"
      tabindex="0"
      role="region"
      aria-label="{{ section.settings.title | escape }} rail"
    >
      {%- for block in section.blocks -%}
        {% render 'purelane-combo-card', block: block %}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_swipecue -%}
      <div class="swipecue" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h13m-5-6 6 6-6 6"/>
        </svg>
        {{ section.settings.swipecue_text | default: 'Swipe for more combos' | escape }}
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="railnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "section-purelane-combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
