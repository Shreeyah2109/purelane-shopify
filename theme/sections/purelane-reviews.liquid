          "settings": {
            "stars": "★★★★★",
            "headline": "Best dishwash ever",
            "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "author": "Priya",
            "product_name": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
