{{ 'purelane.css' | asset_url | stylesheet_tag }}

<section
  class="purelane-scope purelane-reviews-section sec revband"
  id="reviews"
  data-scene="1"
  data-section-id="{{ section.id }}"
  aria-label="{{ section.settings.kicker | default: 'Customer reviews' | escape }}"
>
  <div class="wrap">
    <div class="revhead rv">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}

      {%- if section.settings.aggregate_score != blank or section.settings.reviews_count_text != blank -%}
        <span class="agg">
          {%- if section.settings.aggregate_stars != blank -%}
            <span class="st" aria-hidden="true">{{ section.settings.aggregate_stars | escape }}</span>
          {%- endif -%}
          {%- if section.settings.aggregate_score != blank -%}
            <b>{{ section.settings.aggregate_score | escape }}</b>
          {%- endif -%}
          {%- if section.settings.reviews_count_text != blank -%}
            {{ section.settings.reviews_count_text | escape }}
          {%- endif -%}
        </span>
      {%- endif -%}

      {%- if section.settings.social_proof != blank -%}
        <span class="agg">{{ section.settings.social_proof }}</span>
      {%- endif -%}
    </div>
  </div>

  <div
    class="revrail rv"
    tabindex="0"
    role="region"
    aria-label="{{ section.settings.kicker | default: 'Customer reviews' | escape }} marquee"
  >
    <div class="revtrack">
      {%- comment -%} Primary set of review cards {%- endcomment -%}
      {%- for block in section.blocks -%}
        {% render 'purelane-review-card', block: block %}
      {%- endfor -%}

      {%- comment -%} Cloned set of review cards for seamless infinite CSS loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {% render 'purelane-review-card', block: block, is_duplicate: true %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "section-purelane-reviews",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_stars",
      "label": "Aggregate Stars",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "aggregate_score",
      "label": "Aggregate Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Reviews Count Note",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "social_proof",
      "label": "Social Proof Tagline",
      "default": "Loved by <b>12 lakh+</b> homes",
      "info": "HTML tags like <b> are supported for styling numbers"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Stars Rating",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Review Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer Testimonial",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer Name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Purchased",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "settings": {
        "kicker": "That's what they said",
        "aggregate_stars": "★★★★★",
        "aggregate_score": "4.8",
        "reviews_count_text": "from 8,000+ reviews",
        "social_proof": "Loved by <b>12 lakh+</b> homes"
      },
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": "★★★★★",
