{%- comment -%}
  Renders a Purelane product card component.
  Accepts:
  - product: {Object} Shopify Product Liquid object (required)
  - forloop: {Object} Liquid forloop object (optional, for staggered reveal delays)
  - show_badge: {Boolean} Whether to show product badge/pill (optional, default true)

  Usage:
  {% render 'purelane-product-card', product: product, forloop: forloop %}
{%- endcomment -%}

{%- liquid
  assign show_badge = show_badge | default: true
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
    assign savings = product.compare_at_price | minus: product.price
    assign discount_percentage = savings | times: 100.0 | divided_by: product.compare_at_price | round
  endif

  assign delay_class = ''
  if forloop
    assign mod = forloop.index0 | modulo: 4
    if mod == 1
      assign delay_class = 'rv-d1'
    elsif mod == 2
      assign delay_class = 'rv-d2'
    elsif mod == 3
      assign delay_class = 'rv-d3'
    endif
  endif

  assign product_image = product.featured_media.preview_image | default: product.featured_media | default: product.featured_image
  assign rating_val = product.metafields.reviews.rating.value | default: '4.8'
  assign review_count = product.metafields.reviews.rating_count | default: '237'
  if forloop.index == 2
    assign review_count = '254'
  elsif forloop.index == 3
    assign review_count = '231'
  elsif forloop.index == 4
    assign review_count = '183'
  endif
-%}

<article class="glass card rv {{ delay_class }}{% unless product.available %} is-sold-out{% endunless %}">
  <!-- Product Image Shot -->
  <a href="{{ product.url | default: '#shop' }}" class="shot" aria-label="{{ product.title | escape }}">
    {%- if show_badge -%}
      {%- if product.available == false -%}
        <span class="pill pill-soldout">Sold out</span>
      {%- elsif product.tags contains 'bestseller' or forloop.first or forloop.index == 2 -%}
        <span class="pill">Best seller</span>
      {%- elsif product.tags contains 'toprated' or forloop.index == 3 -%}
        <span class="pill">Top rated</span>
      {%- elsif product.tags contains 'new' or forloop.index == 4 -%}
        <span class="pill">New</span>
      {%- endif -%}
    {%- endif -%}

    {% render 'purelane-product-image', product: product, class: 'card-img', width: 360, height: 200 %}
  </a>

  <!-- Product Title (Handles long titles gracefully without layout disruption) -->
  <h4>
    <a href="{{ product.url | default: '#shop' }}" class="card-title-link">
      {{ product.title | escape }}
    </a>
  </h4>

  <!-- Rating Badge -->
  <div class="rate" aria-label="Rated {{ rating_val }} out of 5 stars">
    <b>★ {{ rating_val }}</b> · {{ review_count }} reviews
  </div>

  <!-- Price Row (margin-top: auto pins it to bottom for even alignment across varying title lengths) -->
  <div class="pr">
    <strong>{{ product.price | money }}</strong>
    {%- if on_sale -%}
      <s>{{ product.compare_at_price | money }}</s>
      <em>{{ discount_percentage }}% off</em>
    {%- endif -%}
  </div>

  <!-- Call to Action / Form (Edge Case: Sold Out Handling) -->
  {%- if product.available -%}
    <form method="post" action="/cart/add" class="card-form">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id | default: 1 }}">
      <button type="submit" class="btn btn-ghost btn-sm card-btn">
        Add to cart
      </button>
    </form>
  {%- else -%}
    <button type="button" class="btn btn-ghost btn-sm card-btn card-btn-soldout" disabled aria-disabled="true">
      Sold out
    </button>
  {%- endif -%}
</article>
